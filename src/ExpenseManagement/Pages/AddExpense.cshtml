@page
@model AddExpenseModel
@{
    ViewData["Title"] = "Add Expense";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Database Error:</strong> @Model.ErrorMessage
    </div>
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow-sm" style="max-width: 600px; margin: 0 auto;">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-plus-circle"></i> Add Expense
            </h3>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label for="amount" class="form-label">Amount (£)</label>
                    <input type="number" step="0.01" class="form-control" id="amount" name="amount" required />
                </div>

                <div class="mb-3">
                    <label for="expenseDate" class="form-label">Date</label>
                    <input type="date" class="form-control" id="expenseDate" name="expenseDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="mb-3">
                    <label for="categoryId" class="form-label">Category</label>
                    <select class="form-select" id="categoryId" name="categoryId" required>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryId">@category.CategoryName</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea class="form-control" id="description" name="description" rows="4" placeholder="Enter expense details..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Submit
                    </button>
                    <a href="/Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
