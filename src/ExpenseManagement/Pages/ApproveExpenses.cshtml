@page
@model ApproveExpensesModel
@{
    ViewData["Title"] = "Approve Expenses";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Database Error:</strong> @Model.ErrorMessage
    </div>
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h3 class="mb-0">
                <i class="bi bi-check2-square"></i> Approve Expenses
            </h3>
        </div>
        <div class="card-body">
            <h5 class="mb-3">Pending expenses:</h5>

            <div class="row mb-4">
                <div class="col-md-6">
                    <form method="get" class="d-flex gap-2">
                        <input type="text" name="filter" value="@Model.Filter" class="form-control" placeholder="Filter expenses..." />
                        <button type="submit" class="btn btn-outline-success">
                            <i class="bi bi-search"></i> Filter
                        </button>
                        @if (!string.IsNullOrEmpty(Model.Filter))
                        {
                            <a href="/ApproveExpenses" class="btn btn-outline-secondary">Clear</a>
                        }
                    </form>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Employee</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PendingExpenses.Any())
                        {
                            @foreach (var expense in Model.PendingExpenses)
                            {
                                <tr>
                                    <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                    <td>@expense.UserName</td>
                                    <td>@expense.CategoryName</td>
                                    <td>£@expense.Amount.ToString("N2")</td>
                                    <td>@expense.Description</td>
                                    <td>
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                            <input type="hidden" name="action" value="approve" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check-circle"></i> Approve
                                            </button>
                                        </form>
                                        <form method="post" class="d-inline ms-1">
                                            <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                            <input type="hidden" name="action" value="reject" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-x-circle"></i> Reject
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">No pending expenses</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
