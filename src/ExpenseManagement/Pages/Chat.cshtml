@page
@model ChatModel
@{
    ViewData["Title"] = "AI Chat";
}

<div class="container-fluid px-4 py-4">
    <div class="card shadow-sm" style="max-width: 900px; margin: 0 auto;">
        <div class="card-header bg-info text-white">
            <h3 class="mb-0">
                <i class="bi bi-chat-dots"></i> AI Expense Assistant
            </h3>
            <small>Ask me to help manage your expenses using natural language</small>
        </div>
        <div class="card-body p-0">
            <div id="chatMessages" style="height: 500px; overflow-y: auto; padding: 20px; background-color: #f8f9fa;">
                <div class="alert alert-info">
                    <strong>👋 Hello!</strong> I can help you with:
                    <ul class="mb-0 mt-2">
                        <li>View your expenses</li>
                        <li>Create new expenses</li>
                        <li>Submit expenses for approval</li>
                        <li>Check pending approvals (if you're a manager)</li>
                    </ul>
                    <p class="mt-2 mb-0">Try: "Show me my expenses" or "Add a £50 meal expense for today"</p>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <form id="chatForm" method="post" onsubmit="return sendMessage(event);">
                <div class="input-group">
                    <input type="text" id="messageInput" name="message" class="form-control" 
                           placeholder="Type your message..." required autofocus />
                    <button type="submit" class="btn btn-primary" id="sendButton">
                        <i class="bi bi-send"></i> Send
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let chatEnabled = @Model.ChatEnabled.ToString().ToLower();

        function sendMessage(event) {
            event.preventDefault();
            
            const input = document.getElementById('messageInput');
            const message = input.value.trim();
            
            if (!message) return false;

            // Add user message to chat
            addMessage(message, 'user');
            input.value = '';
            
            // Disable input while processing
            const sendButton = document.getElementById('sendButton');
            sendButton.disabled = true;
            sendButton.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processing...';

            // Send to server
            fetch('/Chat?handler=SendMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ message: message })
            })
            .then(response => response.json())
            .then(data => {
                addMessage(data.response, 'assistant');
            })
            .catch(error => {
                addMessage('❌ Error: ' + error.message, 'error');
            })
            .finally(() => {
                sendButton.disabled = false;
                sendButton.innerHTML = '<i class="bi bi-send"></i> Send';
                input.focus();
            });

            return false;
        }

        function addMessage(text, type) {
            const messagesDiv = document.getElementById('chatMessages');
            const messageDiv = document.createElement('div');
            messageDiv.className = 'mb-3';
            
            if (type === 'user') {
                messageDiv.innerHTML = `
                    <div class="d-flex justify-content-end">
                        <div class="card bg-primary text-white" style="max-width: 70%;">
                            <div class="card-body py-2 px-3">
                                <small><strong>You</strong></small>
                                <p class="mb-0">${escapeHtml(text)}</p>
                            </div>
                        </div>
                    </div>`;
            } else {
                const bgClass = type === 'error' ? 'bg-danger text-white' : 'bg-white';
                messageDiv.innerHTML = `
                    <div class="d-flex justify-content-start">
                        <div class="card ${bgClass}" style="max-width: 70%;">
                            <div class="card-body py-2 px-3">
                                <small><strong>🤖 Assistant</strong></small>
                                <p class="mb-0">${formatMessage(text)}</p>
                            </div>
                        </div>
                    </div>`;
            }
            
            messagesDiv.appendChild(messageDiv);
            messagesDiv.scrollTop = messagesDiv.scrollHeight;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function formatMessage(text) {
            // Convert markdown-style formatting
            text = escapeHtml(text);
            text = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            text = text.replace(/\n/g, '<br>');
            return text;
        }

        // Show warning if chat not enabled
        if (!chatEnabled) {
            addMessage('⚠️ Chat UI is not fully configured. Deploy with INCLUDE_CHAT_UI=true in deploy.sh to enable AI features.', 'error');
        }
    </script>
}
